# OneDesk India Serverless Environment Configuration

# Core Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection
# Replace with your MongoDB Atlas staging cluster URI:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/onedesk_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/onedesk_staging

# Cryptographic Session & JWT Secrets
JWT_SECRET=onedesk_super_secret_jwt_key_2026_secure_random_string_89327498
JWT_EXPIRES_IN=7d
COOKIE_SECRET=onedesk_cookie_secret_key_84930218

# Distributed Rate Limiting (Upstash Redis)
# Free serverless Redis from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloud Object Storage (Cloudinary private storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BLOB_READ_WRITE_TOKEN=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_onedesk2026
RAZORPAY_KEY_SECRET=onedesk_razorpay_secret_test_key_8492
RAZORPAY_WEBHOOK_SECRET=

# Vercel Cron Security Secret
CRON_SECRET=onedesk_cron_secret_random_token_9381

# Mobile SMS OTP Gateways (MSG91 / Fast2SMS)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# WhatsApp Business API Notifications
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Transactional Email Service (Resend or Brevo / SMTP)
RESEND_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OneDesk India <noreply@onedesk.india.gov.in>"

# Primary Super Administrator Bootstrap Account
ADMIN_BOOTSTRAP_EMAIL=admin@onedesk.in
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisPasswordInProduction123!
ADMIN_BOOTSTRAP_NAME="Administrator"
ADMIN_BOOTSTRAP_MOBILE=
