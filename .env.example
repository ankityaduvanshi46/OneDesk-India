# OneDesk India Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection
# Replace with your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/onedesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/onedesk_india

# JWT Authentication Secrets
JWT_SECRET=onedesk_super_secret_jwt_key_2026_secure_random_string_89327498
JWT_EXPIRES_IN=7d
COOKIE_SECRET=onedesk_cookie_secret_key_84930218

# Email Transporter (Brevo / SendGrid / Custom SMTP)
# Leave empty or set to 'development' to log OTPs to console
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OneDesk India <noreply@onedesk.india.gov.in>"

# Admin Bootstrap Credentials (Optional)
ADMIN_BOOTSTRAP_EMAIL=admin@onedesk.in
ADMIN_BOOTSTRAP_PASSWORD=Admin@OneDesk2026
ADMIN_BOOTSTRAP_NAME=Super Administrator
